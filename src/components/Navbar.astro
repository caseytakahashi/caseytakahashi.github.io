<nav class="bg-white border-b border-gray-200 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Small screen layout: hamburger + centered logo -->
        <div class="flex items-center justify-between h-20 md:hidden">
          <button
            id="hamburger-btn"
            type="button"
            class="p-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 rounded-md transition-colors"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle navigation menu"
          >
            <svg
              id="hamburger-icon"
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              id="close-icon"
              class="w-6 h-6 hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          
          <a href="/" class="absolute left-1/2 transform -translate-x-1/2">
            <img
              src="/casey-takahashi-logo.png"
              alt="Casey Takahashi Photography"
              class="h-auto w-[180px]"
            />
          </a>
          
          <!-- Spacer to balance the hamburger button -->
          <div class="w-10"></div>
        </div>
        
        <!-- Medium+ screen layout: original grid -->
        <div class="hidden md:grid grid-cols-[1fr_1fr_auto_1fr_1fr] items-center h-20 sm:h-24 lg:h-28">
          <a class="nav-link-desktop text-center" href="/">Portfolio</a>
          <a class="nav-link-desktop text-center" href="/about">About</a>
        
          <a href="/" class="block px-4">
            <img
              src="/casey-takahashi-logo.png"
              alt="Casey Takahashi Photography"
              class="h-auto w-[220px] sm:w-[260px] lg:w-[300px] mx-auto"
            />
          </a>
        
          <a class="nav-link-desktop text-center" href="/pricing">Pricing</a>
          <a class="nav-link-desktop text-center" href="/contact">Contact</a>
        </div>
    </div>
    
    <!-- Mobile dropdown menu -->
    <div
      id="mobile-menu"
      class="hidden absolute top-full left-0 w-48 bg-white border-b border-gray-200 shadow-lg z-50"
      role="menu"
      aria-labelledby="hamburger-btn"
    >
      <a href="/" class="nav-link-mobile" role="menuitem" >
        Portfolio
      </a>
      <a href="/about" class="nav-link-mobile" role="menuitem" >
        About
      </a>
      <a href="/pricing" class="nav-link-mobile" role="menuitem" >
        Pricing
      </a>
      <a href="/contact" class="nav-link-mobile" role="menuitem" >
        Contact
      </a>
    </div>
</nav>

<script>
  (function() {
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    
    if (!hamburgerBtn || !mobileMenu || !hamburgerIcon || !closeIcon) return;
    
    const menuLinks = mobileMenu.querySelectorAll('a[role="menuitem"]');
    
    const openMenu = () => {
      mobileMenu.classList.remove('hidden');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    };
    
    const closeMenu = () => {
      mobileMenu.classList.add('hidden');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    };
    
    const toggleMenu = () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    };
    
    // Toggle on hamburger click
    hamburgerBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });
    
    // Close on link click
    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
    
    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        closeMenu();
        hamburgerBtn.focus();
      }
    });
    
    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!mobileMenu.classList.contains('hidden')) {
        const target = e.target as HTMLElement;
        if (!mobileMenu.contains(target) && !hamburgerBtn.contains(target)) {
          closeMenu();
        }
      }
    });
  })();
</script>