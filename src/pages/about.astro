---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="min-h-screen bg-white">
		<section class="mx-auto max-w-3xl px-6 py-24">
			<p class="text-sm uppercase tracking-[0.3em] text-slate-500">About</p>
			<h1 class="mb-6 text-4xl font-semibold text-slate-900">Crafting calm, considered imagery</h1>
			<p class="text-lg text-slate-600">
				This section will tell the studio story, approach, and background once the copy is ready.
			</p>
		</section>
	</main>
</Layout>

