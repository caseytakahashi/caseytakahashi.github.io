---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="min-h-screen bg-slate-50">
		<section class="mx-auto max-w-3xl px-6 py-24">
			<p class="text-sm uppercase tracking-[0.3em] text-slate-500">Contact</p>
			<h1 class="mb-6 text-4xl font-semibold text-slate-900">Let’s plan your session</h1>
			<p class="text-lg text-slate-600">A simple contact form and studio info will live here.</p>
			<div class="mt-10 grid gap-6 sm:grid-cols-2">
				<div class="rounded-2xl border border-slate-200 bg-white p-6">
					<p class="text-sm text-slate-500">Email</p>
					<p class="text-xl text-slate-900">hello@example.com</p>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-white p-6">
					<p class="text-sm text-slate-500">Phone</p>
					<p class="text-xl text-slate-900">(555) 000-0000</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

