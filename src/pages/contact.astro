---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page-background">
		<section class="page-layout">
			<p class="text-sm uppercase tracking-[0.3em] text-slate-500">Contact</p>
			<h1 class="mb-6 text-4xl font-semibold text-slate-900">Let’s plan your session</h1>
			<p class="text-lg text-slate-600">A simple contact form and studio info will live here.</p>
			<div class="mt-10 grid gap-6 sm:grid-cols-2">
				<div class="contact-card-container">
					<p class="contact-card-title">Email</p>
					<p class="contact-card-text">hello@example.com</p>
				</div>
				<div class="contact-card-container">
					<p class="contact-card-title">Phone</p>
					<p class="contact-card-text">(555) 000-0000</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

