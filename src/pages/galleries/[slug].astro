---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { readdir } from 'node:fs/promises';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';

type GalleryEntry = CollectionEntry<'galleries'>;

// Type for galleries with subdirectories (sectioned galleries)
interface GallerySection {
	id: string;           // e.g., "01-landscapes"
	displayName: string;  // e.g., "Landscapes" (title-cased)
	description: string;  // Optional placeholder description
	images: string[];     // Array of image URLs
}

// Pre-generate gallery pages from content md files.
export async function getStaticPaths() {
	const galleries = await getCollection('galleries');
	return galleries.map((gallery) => ({
		params: { slug: gallery.id },
		props: { gallery }
	}));
}

const { gallery } = Astro.props;
let galleryImages: string[] = [];
let gallerySections: GallerySection[] = [];
let isSectionedGallery = false;

// Convert directory name to display title (e.g., "01-landscapes" -> "Landscapes")
function toDisplayName(dirName: string): string {
	// Remove leading number prefix (e.g., "01-", "02-") and convert to title case
	const withoutPrefix = dirName.replace(/^\d+-/, '');
	return withoutPrefix
		.split('-')
		.map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
		.join(' ');
}

// Get placeholder description for each section
function getSectionDescription(sectionId: string): string {
	const descriptions: Record<string, string> = {
		'01-landscapes': 'Wide vistas and intimate details from desert canyons, mountain ridges, and coastal horizons.',
		'02-wildlife': 'Quiet encounters with creatures in their natural habitats.',
		'03-silhouettes': 'Form and shadow at the edges of day.',
		'04-pets': 'Beloved companions, captured with personality and warmth.'
	};
	return descriptions[sectionId] || '';
}

// Collect images from a single directory (non-recursive)
async function collectImagesFromDir(dirPath: string, basePath: string, subDir: string): Promise<string[]> {
	const images: string[] = [];
	try {
		const entries = await readdir(dirPath, { withFileTypes: true });
		for (const entry of entries) {
			if (entry.isFile() && /\.(png|jpe?g|webp)$/i.test(entry.name)) {
				const urlPath = `/galleries/${basePath}/${subDir}/${entry.name}`;
				images.push(urlPath);
			}
		}
	} catch (error) {
		// Silently skip directories that can't be read
	}
	return images.sort();
}

// Recursively collect all image files from a directory
async function collectImages(dirPath: string, basePath: string, relativePath: string = ''): Promise<string[]> {
	const images: string[] = [];
	try {
		const entries = await readdir(dirPath, { withFileTypes: true });
		
		for (const entry of entries) {
			const fullPath = join(dirPath, entry.name);
			const relativeFilePath = relativePath ? `${relativePath}/${entry.name}` : entry.name;
			
			if (entry.isDirectory()) {
				// Recursively search subdirectories
				const subImages = await collectImages(fullPath, basePath, relativeFilePath);
				images.push(...subImages);
			} else if (entry.isFile() && /\.(png|jpe?g|webp)$/i.test(entry.name)) {
				// Build URL path relative to /galleries/
				const urlPath = `/galleries/${basePath}/${relativeFilePath}`;
				images.push(urlPath);
			}
		}
	} catch (error) {
		// Silently skip directories that can't be read
	}
	
	return images;
}

// Discover subdirectories and build sections
async function discoverSections(galleryDirPath: string, galleryDirName: string): Promise<GallerySection[]> {
	const sections: GallerySection[] = [];
	try {
		const entries = await readdir(galleryDirPath, { withFileTypes: true });
		const subdirs = entries.filter(e => e.isDirectory()).sort((a, b) => a.name.localeCompare(b.name));
		
		for (const subdir of subdirs) {
			const subdirPath = join(galleryDirPath, subdir.name);
			const images = await collectImagesFromDir(subdirPath, galleryDirName, subdir.name);
			
			if (images.length > 0) {
				sections.push({
					id: subdir.name,
					displayName: toDisplayName(subdir.name),
					description: getSectionDescription(subdir.name),
					images
				});
			}
		}
	} catch (error) {
		// Fall back to non-sectioned gallery
	}
	return sections;
}

if (gallery) {
	try {
		// Remove .md extension from gallery.id to match directory name
		const galleryDirName = gallery.id.replace(/\.md$/, '');
		const publicGalleryDir = new URL(
			`../../../public/galleries/${galleryDirName}/`,
			import.meta.url
		);
		const galleryDirPath = fileURLToPath(publicGalleryDir);
		
		// First, check if this gallery has subdirectories (sectioned gallery)
		const sections = await discoverSections(galleryDirPath, galleryDirName);
		
		if (sections.length > 1) {
			// This is a sectioned gallery (like "Beyond the Portrait")
			isSectionedGallery = true;
			gallerySections = sections;
			// Flatten all images for lightbox functionality
			galleryImages = sections.flatMap(s => s.images);
		} else {
			// Standard flat gallery - use existing logic
			const fromPublic = await collectImages(galleryDirPath, galleryDirName);
			fromPublic.sort();

			let configuredOrder: string[] = [];
			if (gallery.data.imageCount) {
				configuredOrder = Array.from(
					{ length: gallery.data.imageCount },
					(_, i) => `${gallery.data.basePath}/${String(i + 1).padStart(2, '0')}.webp`
				).filter((imagePath) => fromPublic.includes(imagePath));
			} else if (gallery.data.images) {
				configuredOrder = gallery.data.images
					.map((filename) => `${gallery.data.basePath}/${filename}`)
					.filter((imagePath) => fromPublic.includes(imagePath));
			}
			galleryImages = configuredOrder.length > 0 ? configuredOrder : fromPublic;
		}
	} catch (error) {
		console.warn(`Unable to read images for gallery "${gallery.id}":`, error);
		if (gallery.data.imageCount) {
			galleryImages = Array.from(
				{ length: gallery.data.imageCount },
				(_, i) => `${gallery.data.basePath}/${String(i + 1).padStart(2, '0')}.webp`
			);
		} else if (gallery.data.images) {
			galleryImages = gallery.data.images.map((filename) => `${gallery.data.basePath}/${filename}`);
		}
	}
}

// For standard (non-sectioned) galleries: split into columns
const leftImages = !isSectionedGallery ? galleryImages.filter((_, i) => i % 2 === 0) : [];
const rightImages = !isSectionedGallery ? galleryImages.filter((_, i) => i % 2 === 1) : [];

// Manually move images to the left or right column based on the leftOffset value.
const leftOffset = gallery?.data?.leftOffset ?? 0;
if (!isSectionedGallery && leftOffset > 0) {
  const moved = rightImages.splice(-leftOffset);
  leftImages.push(...moved);
} else if (!isSectionedGallery && leftOffset < 0) {
  const moved = leftImages.splice(leftOffset); 
  rightImages.push(...moved);
}

// Build a global index map for lightbox navigation in sectioned galleries
let globalImageIndex = 0;
const sectionImageIndices: Map<string, number[]> = new Map();
if (isSectionedGallery) {
	for (const section of gallerySections) {
		const indices: number[] = [];
		for (let i = 0; i < section.images.length; i++) {
			indices.push(globalImageIndex++);
		}
		sectionImageIndices.set(section.id, indices);
	}
}
---

<Layout>
	<main class="page-background">
		{!gallery ? (
			<section class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-24 text-center">
				<h1 class="text-3xl font-semibold text-slate-900">Not found</h1>
				<p class="text-slate-600">We couldn’t locate the requested gallery.</p>
				<a class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500" href="/galleries"
					>Back to galleries</a
				>
			</section>
		) : isSectionedGallery ? (
			<!-- ========================================== -->
			<!-- SECTIONED GALLERY LAYOUT (Beyond the Portrait) -->
			<!-- ========================================== -->
			<section class="page-layout">
				<!-- Page title -->
				<div class="flex flex-col gap-4 mb-6">
					<h1 class="page-title">{gallery.data.title}</h1>
				</div>

				<!-- Section Navigation Bar (sticky on scroll) -->
				<nav 
					id="section-nav"
					class="section-nav sticky top-0 z-40 -mx-8 sm:-mx-14 lg:-mx-24 px-8 sm:px-14 lg:px-24 py-3 bg-slate-50/95 backdrop-blur-sm border-b border-slate-200 mb-16"
				>
					<div class="flex items-center gap-6">
						<a
							id="back-to-portfolio-float"
							href="/galleries"
							class="flex items-center gap-1.5 rounded-full bg-white/80 px-3 py-1.5 text-xs font-medium text-slate-500 shadow-sm backdrop-blur-md border border-slate-200/60 transition-all duration-200 ease-out hover:bg-white hover:text-slate-900 hover:shadow-md group shrink-0"
							aria-label="Back to Portfolio"
						>
							<svg class="h-3 w-3 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 20 20">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 10H5m0 0l5-5m-5 5l5 5" />
							</svg>
							Portfolio
						</a>
						<div class="h-4 w-px bg-slate-300/60 shrink-0"></div>
						<ul class="flex flex-wrap gap-x-6 gap-y-2 md:gap-x-10">
							{gallerySections.map((section) => (
								<li>
									<a 
										href={`#${section.id}`}
										class="section-nav-link text-sm md:text-base font-myeongjo tracking-wide text-slate-500 hover:text-slate-900 transition-colors duration-200 relative pb-1"
										data-section-link={section.id}
									>
										{section.displayName}
									</a>
								</li>
							))}
						</ul>
					</div>
				</nav>

				<!-- Render each section -->
				{gallerySections.map((section, sectionIdx) => {
					const sectionIndices = sectionImageIndices.get(section.id) || [];
					const baseIndex = sectionIndices[0] || 0;

					const isPanoSection = section.id === '01-landscapes';
					const heroImage = isPanoSection ? section.images[0] : null;
					const remainingImages = isPanoSection ? section.images.slice(1) : section.images;
					const sectionLeftImages = remainingImages.filter((_, i) => i % 2 === 0);
					const sectionRightImages = remainingImages.filter((_, i) => i % 2 === 1);

					return (
						<section 
							id={section.id} 
							class={`gallery-section scroll-mt-24 ${sectionIdx > 0 ? 'mt-28 md:mt-36' : ''}`}
							data-section-id={section.id}
						>
							<!-- Section header with divider line -->
							<div class="mb-10 md:mb-14">
								<h2 class="font-myeongjo text-2xl md:text-3xl text-slate-900 mb-3">
									{section.displayName}
								</h2>
								<div class="w-12 h-px bg-slate-400 mb-5"></div>
								{section.description && (
									<p class="text-slate-500 text-base md:text-lg max-w-2xl leading-relaxed">
										{section.description}
									</p>
								)}
							</div>

							<!-- Mobile: 1 column -->
							<div class="flex flex-col gap-5 md:hidden">
								{section.images.map((imagePath: string, imgIdx: number) => (
									<img
										class="w-full h-auto cursor-pointer transition-opacity hover:opacity-95"
										src={imagePath}
										alt={`${section.displayName} image ${imgIdx + 1}`}
										loading="lazy"
										data-index={baseIndex + imgIdx}
										data-gallery-image
									/>
								))}
							</div>

							<!-- Desktop: panorama hero + 2 columns masonry -->
							<div class="hidden md:flex md:flex-col gap-5 lg:gap-6">
								{heroImage && (
									<img
										class="w-full h-auto cursor-pointer transition-opacity hover:opacity-95"
										src={heroImage}
										alt={`${section.displayName} image 1`}
										loading="lazy"
										data-index={baseIndex}
										data-gallery-image
									/>
								)}

								<div class="grid grid-cols-2 gap-5 lg:gap-6">
									<!-- Left column -->
									<div class="flex flex-col gap-5 lg:gap-6">
										{sectionLeftImages.map((imagePath: string, imgIdx: number) => {
											const offset = heroImage ? 1 : 0;
											return (
												<img
													class="w-full h-auto cursor-pointer transition-opacity hover:opacity-95"
													src={imagePath}
													alt={`${section.displayName} image ${imgIdx * 2 + 1 + offset}`}
													loading="lazy"
													data-index={baseIndex + imgIdx * 2 + offset}
													data-gallery-image
												/>
											);
										})}
									</div>

									<!-- Right column -->
									<div class="flex flex-col gap-5 lg:gap-6">
										{sectionRightImages.map((imagePath: string, imgIdx: number) => {
											const offset = heroImage ? 1 : 0;
											return (
												<img
													class="w-full h-auto cursor-pointer transition-opacity hover:opacity-95"
													src={imagePath}
													alt={`${section.displayName} image ${imgIdx * 2 + 2 + offset}`}
													loading="lazy"
													data-index={baseIndex + imgIdx * 2 + 1 + offset}
													data-gallery-image
												/>
											);
										})}
									</div>
								</div>
							</div>
						</section>
					);
				})}

				<!-- Bottom spacer for editorial feel -->
				<div class="h-20 md:h-28"></div>

				<!-- Lightbox Modal (shared) -->
				<div
					id="lightbox-modal"
					class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
					role="dialog"
					aria-modal="true"
					aria-label="Image lightbox"
					aria-hidden="true"
				>
					<!-- Backdrop (clickable to close) -->
					<div class="absolute inset-0" data-lightbox-backdrop></div>

					<!-- Close button -->
					<button
						id="lightbox-close"
						class="absolute top-4 right-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50"
						aria-label="Close lightbox"
					>
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>

					<!-- Navigation buttons -->
					<button
						id="lightbox-prev"
						class="absolute left-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50"
						aria-label="Previous image"
					>
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
						</svg>
					</button>

					<button
						id="lightbox-next"
						class="absolute right-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50"
						aria-label="Next image"
					>
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
						</svg>
					</button>

					<!-- Image container -->
					<div class="relative z-10 flex max-h-[90vh] max-w-[90vw] items-center justify-center p-4">
						<img
							id="lightbox-image"
							class="max-h-[90vh] max-w-[90vw] object-contain"
							src=""
							alt=""
							data-lightbox-image
						/>
					</div>
				</div>
			</section>
		) : (
			<!-- ========================================== -->
			<!-- STANDARD FLAT GALLERY LAYOUT -->
			<!-- ========================================== -->
			<section class="page-layout">
				<a
					id="back-to-portfolio-float"
					href="/galleries"
					class="sticky top-4 z-40 self-start flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-sm font-medium text-slate-500 shadow-sm shadow-slate-900/5 backdrop-blur-md border border-slate-200/60 transition-all duration-200 ease-out hover:bg-white hover:text-slate-900 hover:shadow-md group"
					aria-label="Back to Portfolio"
				>
					<svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 10H5m0 0l5-5m-5 5l5 5" />
					</svg>
					Portfolio
				</a>

			<div class="flex flex-col gap-4 -mt-4">
				<h1 class="page-title">{gallery.data.title}</h1>
			</div>

				<!-- Mobile: 1 column, strict file order -->
				<div class="flex flex-col gap-2 sm:gap-3 md:hidden">
					{galleryImages.map((imagePath: string, index: number) => (
						<img
							class="w-full h-auto border border-slate-200 shadow-sm cursor-pointer"
							src={imagePath}
							alt={`${gallery.data.title} image ${index + 1}`}
							loading="lazy"
							data-index={index}
							data-gallery-image
						/>
					))}
				</div>

				<!-- Desktop+: 2 columns, masonry-ish distribution -->
				<div class="hidden md:grid md:grid-cols-2 gap-2 sm:gap-3">
					<!-- Left column -->
					<div class="flex flex-col gap-2 sm:gap-3">
						{leftImages.map((imagePath: string, index: number) => (
							<img
								class="w-full h-auto border border-slate-200 shadow-sm cursor-pointer"
								src={imagePath}
								alt={`${gallery.data.title} image ${index * 2 + 1}`}
								loading="lazy"
								data-index={index * 2}
								data-gallery-image
							/>
						))}
					</div>

					<!-- Right column -->
					<div class="flex flex-col gap-2 sm:gap-3">
						{rightImages.map((imagePath: string, index: number) => (
							<img
								class="w-full h-auto border border-slate-200 shadow-sm cursor-pointer"
								src={imagePath}
								alt={`${gallery.data.title} image ${index * 2 + 2}`}
								loading="lazy"
								data-index={index * 2 + 1}
								data-gallery-image
							/>
						))}
					</div>
				</div>

				<!-- Lightbox Modal -->
				<div
					id="lightbox-modal"
					class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
					role="dialog"
					aria-modal="true"
					aria-label="Image lightbox"
					aria-hidden="true"
				>
					<!-- Backdrop (clickable to close) -->
					<div class="absolute inset-0" data-lightbox-backdrop></div>

					<!-- Close button -->
					<button
						id="lightbox-close"
						class="absolute top-4 right-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50"
						aria-label="Close lightbox"
					>
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>

					<!-- Navigation buttons -->
					<button
						id="lightbox-prev"
						class="absolute left-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50"
						aria-label="Previous image"
					>
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
						</svg>
					</button>

					<button
						id="lightbox-next"
						class="absolute right-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50"
						aria-label="Next image"
					>
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
						</svg>
					</button>

					<!-- Image container -->
					<div class="relative z-10 flex max-h-[90vh] max-w-[90vw] items-center justify-center p-4">
						<img
							id="lightbox-image"
							class="max-h-[90vh] max-w-[90vw] object-contain"
							src=""
							alt=""
							data-lightbox-image
						/>
					</div>
				</div>
			</section>
		)}
	</main>
</Layout>

<script>
	// ========================================
	// SECTION NAVIGATION (for sectioned galleries)
	// ========================================
	const sectionNav = document.getElementById('section-nav');
	const sectionLinks = document.querySelectorAll('[data-section-link]');
	const gallerySections = document.querySelectorAll('[data-section-id]');
	
	// Highlight active section link based on scroll position
	function updateActiveSection() {
		if (gallerySections.length === 0) return;
		
		const scrollTop = window.scrollY;
		const navHeight = sectionNav?.offsetHeight || 0;
		const offset = navHeight + 100; // Extra offset for better UX
		
		let activeSection: string | null = null;
		
		gallerySections.forEach((section) => {
			const sectionTop = (section as HTMLElement).offsetTop - offset;
			const sectionId = section.getAttribute('data-section-id');
			
			if (scrollTop >= sectionTop) {
				activeSection = sectionId;
			}
		});
		
		// Update link styles
		sectionLinks.forEach((link) => {
			const linkSection = link.getAttribute('data-section-link');
			if (linkSection === activeSection) {
				link.classList.add('section-nav-link-active');
			} else {
				link.classList.remove('section-nav-link-active');
			}
		});
	}
	
	// Smooth scroll to section on nav link click
	sectionLinks.forEach((link) => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			const sectionId = link.getAttribute('data-section-link');
			const targetSection = document.getElementById(sectionId || '');
			
			if (targetSection) {
				const navHeight = sectionNav?.offsetHeight || 0;
				const targetTop = targetSection.offsetTop - navHeight - 20;
				
				window.scrollTo({
					top: targetTop,
					behavior: 'smooth'
				});
			}
		});
	});
	
	// Throttle scroll handler for performance
	let scrollTimeout: number | null = null;
	window.addEventListener('scroll', () => {
		if (scrollTimeout) return;
		scrollTimeout = window.setTimeout(() => {
			updateActiveSection();
			scrollTimeout = null;
		}, 50);
	});
	
	// Initial check
	updateActiveSection();

	// ========================================
	// LIGHTBOX FUNCTIONALITY
	// ========================================
	const modal = document.getElementById('lightbox-modal');
	const modalImage = document.getElementById('lightbox-image');
	const closeBtn = document.getElementById('lightbox-close');
	const prevBtn = document.getElementById('lightbox-prev');
	const nextBtn = document.getElementById('lightbox-next');
	const backdrop = document.querySelector('[data-lightbox-backdrop]');
	const galleryImagesList = Array.from(
		document.querySelectorAll('[data-gallery-image]')
	);

	// Build meta info for each image element
	const imageMeta = galleryImagesList.map((img) => {
		const el = img as HTMLImageElement;
		const index = parseInt(el.getAttribute('data-index') || '0', 10);

		return {
			index,
			src: el.src,
			alt: el.alt,
		};
	});

	// De-duplicate by index (handles mobile + desktop copies)
	const imageMap = new Map<number, { src: string; alt: string }>();
	for (const item of imageMeta) {
		if (!imageMap.has(item.index)) {
			imageMap.set(item.index, { src: item.src, alt: item.alt });
		}
	}

	// Produce ordered arrays/maps
	const ordered = Array.from(imageMap.entries()).sort((a, b) => a[0] - b[0]);

	const images = ordered.map(([, value]) => value.src);
	const altsByIndex = new Map<number, string>(
		ordered.map(([index, value]) => [index, value.alt])
	);

	let currentIndex = 0;

	function openLightbox(index: number) {
		if (!modal || !modalImage || index < 0 || index >= images.length) return;

		currentIndex = index;
		(modalImage as HTMLImageElement).src = images[index];
		(modalImage as HTMLImageElement).alt =
			altsByIndex.get(index) || `Image ${index + 1}`;

		modal.classList.remove('hidden');
		modal.classList.add('flex');
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';

		// Update navigation button visibility
		updateNavigationButtons();
	}

	function closeLightbox() {
		if (!modal) return;

		modal.classList.add('hidden');
		modal.classList.remove('flex');
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';

		// Clear image src to stop loading
		if (modalImage) {
			(modalImage as HTMLImageElement).src = '';
		}
	}

	function navigate(direction: 'prev' | 'next') {
		if (images.length === 0) return;

		if (direction === 'prev') {
			currentIndex = currentIndex > 0 ? currentIndex - 1 : images.length - 1;
		} else {
			currentIndex = currentIndex < images.length - 1 ? currentIndex + 1 : 0;
		}

		if (modalImage) {
			(modalImage as HTMLImageElement).src = images[currentIndex];
			(modalImage as HTMLImageElement).alt =
				altsByIndex.get(currentIndex) || `Image ${currentIndex + 1}`;
		}

		updateNavigationButtons();
	}

	function updateNavigationButtons() {
		if (images.length <= 1) {
			if (prevBtn) prevBtn.style.display = 'none';
			if (nextBtn) nextBtn.style.display = 'none';
		} else {
			if (prevBtn) prevBtn.style.display = 'flex';
			if (nextBtn) nextBtn.style.display = 'flex';
		}
	}

	// Mobile swipe support
	let touchStartX = 0;
	let touchStartY = 0;
	let touchEndX = 0;
	let touchEndY = 0;
	const SWIPE_THRESHOLD = 50; // px

	function handleTouchStart(e: TouchEvent) {
		if (e.touches.length !== 1) return; // ignore pinch / multi-touch
		const touch = e.touches[0];
		touchStartX = touch.clientX;
		touchStartY = touch.clientY;
		touchEndX = touchStartX;
		touchEndY = touchStartY;
	}

	function handleTouchMove(e: TouchEvent) {
		if (e.touches.length !== 1) return;
		const touch = e.touches[0];
		touchEndX = touch.clientX;
		touchEndY = touch.clientY;
	}

	function handleTouchEnd() {
		const dx = touchEndX - touchStartX;
		const dy = touchEndY - touchStartY;

		// Only treat as swipe if horizontal movement is dominant
		if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy)) {
			return;
		}

		if (dx < 0) {
			// Swiped left → next image
			navigate('next');
		} else {
			// Swiped right → previous image
			navigate('prev');
		}
	}

	// Open lightbox on image click
	galleryImagesList.forEach((img) => {
		img.addEventListener('click', () => {
			const index = parseInt(img.getAttribute('data-index') || '0', 10);
			openLightbox(index);
		});
	});

	// Close button
	if (closeBtn) {
		closeBtn.addEventListener('click', closeLightbox);
	}

	// Navigation buttons
	if (prevBtn) {
		prevBtn.addEventListener('click', () => navigate('prev'));
	}
	if (nextBtn) {
		nextBtn.addEventListener('click', () => navigate('next'));
	}

	// Backdrop click (but not image click)
	if (backdrop) {
		backdrop.addEventListener('click', (e) => {
			if (e.target === backdrop) {
				closeLightbox();
			}
		});
	}

	// Attach swipe listeners to the image (so you swipe directly on the photo)
	if (modalImage) {
		modalImage.addEventListener('touchstart', handleTouchStart, { passive: true });
		modalImage.addEventListener('touchmove', handleTouchMove, { passive: true });
		modalImage.addEventListener('touchend', handleTouchEnd);
	}

	// Keyboard navigation
	document.addEventListener('keydown', (e) => {
		if (!modal || modal.classList.contains('hidden')) return;

		if (e.key === 'Escape') {
			closeLightbox();
		} else if (e.key === 'ArrowLeft') {
			navigate('prev');
		} else if (e.key === 'ArrowRight') {
			navigate('next');
		}
	});

	// ========================================
	// HIDE BACK BUTTON WHEN LIGHTBOX IS OPEN
	// ========================================
	const floatingBtn = document.getElementById('back-to-portfolio-float');
	const lightboxForBtn = document.getElementById('lightbox-modal');

	if (floatingBtn && lightboxForBtn) {
		const lightboxObserver = new MutationObserver(() => {
			floatingBtn.style.visibility = lightboxForBtn.classList.contains('hidden') ? '' : 'hidden';
		});
		lightboxObserver.observe(lightboxForBtn, { attributes: true, attributeFilter: ['class'] });
	}
</script>
