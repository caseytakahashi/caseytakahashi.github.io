---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { readdir } from 'node:fs/promises';

type GalleryEntry = CollectionEntry<'galleries'>;

// Pre-generate gallery pages from content md files.
export async function getStaticPaths() {
	const galleries = await getCollection('galleries');
	return galleries.map((gallery) => ({
		params: { slug: gallery.id },
		props: { gallery }
	}));
}

const { gallery } = Astro.props;
let galleryImages: string[] = [];

if (gallery) {
	try {
		// Remove .md extension from gallery.id to match directory name
		const galleryDirName = gallery.id.replace(/\.md$/, '');
		const publicGalleryDir = new URL(
			`../../../public/galleries/${galleryDirName}/`,
			import.meta.url
		);
		const files = await readdir(publicGalleryDir);
		const fromPublic = files
			.filter((file) => /\.(png|jpe?g|webp|avif)$/i.test(file)) // Only process image files.
			.map((file) => `/galleries/${galleryDirName}/${file}`) // Build URL to each image.
			.sort(); // Sort images alphabetically (labeled in ascending numbers).

		// Filter out images from gallery that don't exist in public dir.
		const configuredOrder = gallery.data.images.filter((imagePath) => fromPublic.includes(imagePath));
		galleryImages = configuredOrder.length > 0 ? configuredOrder : fromPublic;
	} catch (error) {
		console.warn(`Unable to read images for gallery "${gallery.id}":`, error);
		galleryImages = gallery.data.images;
	}
}
---

<Layout>
	<main class="min-h-screen bg-slate-50">
		{!gallery ? (
			<section class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-24 text-center">
				<h1 class="text-3xl font-semibold text-slate-900">Not found</h1>
				<p class="text-slate-600">We couldn’t locate the requested gallery.</p>
				<a class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500" href="/galleries"
					>Back to galleries</a
				>
			</section>
		) : (
			<section class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-24">
				<a
					href="/galleries"
					class="flex items-center text-sm text-slate-600 hover:text-slate-900 mb-4 w-fit group"
				>
					<svg class="h-4 w-4 mr-2 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 10H5m0 0l5-5m-5 5l5 5" />
					</svg>
					Back to Portfolio
				</a>
				<div class="flex flex-col gap-4">
					<h1 class="text-4xl font-semibold text-slate-900">{gallery.data.title}</h1>
					<div class="flex flex-wrap gap-6 text-sm text-slate-600">
						<span class="font-medium text-slate-900">{gallery.data.location}</span>
					</div>
				</div>
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{galleryImages.map((imagePath: string, index: number) => (
						<img
							class="h-full w-full rounded-2xl border border-slate-200 object-cover shadow-sm"
							src={imagePath}
							alt={`${gallery.data.title} image ${index + 1}`}
							loading="lazy"
						/>
					))}
				</div>
			</section>
		)}
	</main>
</Layout>

