---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const galleries = (await getCollection('galleries'))
---

<Layout>
	<main class="page-layout">
		<section class="mx-auto flex max-w-7xl flex-col gap-8 px-8 sm:px-14 lg:px-24 py-24">
			<div>
				<p class="text-sm uppercase tracking-[0.3em] text-slate-500">Portfolio</p>
				<h1 class="text-4xl font-semibold text-slate-900">Curated shoots</h1>
				<p class="mt-3 text-base text-slate-600">Explore recent sessions and stories.</p>
			</div>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{galleries.map((gallery: CollectionEntry<'galleries'>) => (
					<a
						class="group overflow-hidden rounded-lg border border-slate-200 bg-white transition hover:border-slate-400 hover:shadow-lg"
						href={`/galleries/${gallery.id}`}
					>
						<div class="aspect-4/3 w-full overflow-hidden bg-slate-100">
							<img
								class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
								src={gallery.data.coverImage}
								alt={gallery.data.title}
								loading="lazy"
							/>
						</div>
						<div class="flex flex-col gap-2 px-5 py-6">
							<h2 class="text-xl font-semibold text-slate-900">{gallery.data.title}</h2>
							<p class="text-sm text-slate-500">{gallery.data.location}</p>
						</div>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>

