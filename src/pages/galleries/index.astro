---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
	<main class="min-h-screen bg-slate-50">
		<section class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-24">
			<div>
				<p class="text-sm uppercase tracking-[0.3em] text-slate-500">Galleries</p>
				<h1 class="text-4xl font-semibold text-slate-900">Curated shoots</h1>
			</div>
			<div class="grid gap-6 sm:grid-cols-2">
				{Array.from({ length: 4 }).map((_, index) => (
					<a
						class="rounded-2xl border border-slate-200 bg-white p-6 text-left transition hover:border-slate-400"
						href={`/galleries/sample-${index + 1}`}
					>
						<p class="text-sm text-slate-500">Category {index + 1}</p>
						<h2 class="text-2xl font-medium text-slate-900">Sample shoot {index + 1}</h2>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>

