---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const slideshowImages: { src: string; x?: string; y?: string; scale?: number }[] = [
	{ src: '/galleries/02-families/01.webp',    y: '40%' },
	{ src: '/galleries/01-engagements/07.webp', y: '80%' },
	{ src: '/galleries/03-newborns/02.webp',    y: '90%' },
	{ src: '/galleries/01-engagements/08.webp', y: '55%', x: '30%' },
	{ src: '/galleries/03-newborns/04.webp',    y: '30%' },
];
---

<Layout>
	<main class="relative h-[calc(100vh-5rem)] sm:h-[calc(100vh-6rem)] lg:h-[calc(100vh-7rem)] overflow-hidden">
		<!-- Slideshow background -->
		<div id="slideshow" class="absolute inset-0">
			{slideshowImages.map((slide, i) => (
				<div
					class:list={[
						"slideshow-slide absolute inset-0 transition-opacity duration-2000 ease-in-out",
						i === 0 ? "opacity-100" : "opacity-0"
					]}
					data-slide={i}
				>
					<img
						src={slide.src}
						alt=""
						class="h-full w-full object-cover"
						style={`object-position: ${slide.x ?? 'center'} ${slide.y ?? 'center'};${slide.scale ? ` transform: scale(${slide.scale});` : ''}`}
						loading={i === 0 ? "eager" : "lazy"}
					/>
				</div>
			))}
			<!-- Dark overlay for text legibility -->
			<div class="absolute inset-0 bg-black/40"></div>
		</div>

		<!-- Content -->
		<section class="relative z-10 flex h-full flex-col items-center justify-center gap-6 px-8 text-center">
			<h1 class="landing-title text-white drop-shadow-lg">Portrait photography in the SF Bay Area</h1>
			<p class="landing-text text-white/85 drop-shadow-md">
				Families &bull; Couples &bull; Individuals
			</p>
			<div class="mt-2 flex flex-wrap justify-center gap-4">
				<a
					class="rounded-full bg-white px-6 py-3 text-sm font-medium text-slate-900 transition hover:bg-white/90"
					href="/galleries"
				>
					View Portfolio
				</a>
				<a
					class="rounded-full border border-white px-6 py-3 text-sm font-medium text-white transition hover:bg-white/10"
					href="/contact"
				>
					Book a Session
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	const slides = document.querySelectorAll('.slideshow-slide');
	if (slides.length > 1) {
		let current = 0;
		const INTERVAL = 4000;

		setInterval(() => {
			const next = (current + 1) % slides.length;
			slides[current].classList.remove('opacity-100');
			slides[current].classList.add('opacity-0');
			slides[next].classList.remove('opacity-0');
			slides[next].classList.add('opacity-100');
			current = next;
		}, INTERVAL);
	}
</script>
