---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page-background">
		<section class="page-layout">
			<h1 class="page-title">Pricing & Packages</h1>
			<p class="mb-12 text-lg text-slate-600">
				Pricing information will be available here once packages and rates are finalized.
			</p>

			<div class="grid gap-8 md:grid-cols-2">
				<div class="pricing-card-container">
					<h2 class="pricing-card-title">Portrait Sessions</h2>
					<p class="pricing-card-text"> Individual and family portrait sessions. Pricing details coming soon.  </p>
					<div class="text-3xl font-semibold text-slate-900">—</div>
				</div>

				<div class="pricing-card-container">
					<h2 class="pricing-card-title">Wedding & Events</h2>
					<p class="pricing-card-text"> Full-day coverage for weddings and special events. Custom packages available.  </p>
					<div class="text-3xl font-semibold text-slate-900">—</div>
				</div>

				<div class="pricing-card-container">
					<h2 class="pricing-card-title">Commercial</h2>
					<p class="pricing-card-text"> Brand photography, product shoots, and commercial projects. Contact for quote.  </p>
					<div class="text-3xl font-semibold text-slate-900">—</div>
				</div>

				<div class="pricing-card-container">
					<h2 class="pricing-card-title">Custom Packages</h2>
					<p class="pricing-card-text"> Tailored sessions designed to fit your specific needs and vision.  </p>
					<div class="text-3xl font-semibold text-slate-900">—</div>
				</div>
			</div>

			<div class="mt-12 rounded-2xl border border-slate-200 bg-slate-900 p-8 text-center">
				<h2 class="mb-4 text-2xl font-semibold text-white">Ready to get started?</h2>
				<p class="mb-6 text-slate-300">
					Let's discuss your project and create something beautiful together.
				</p>
			<a href="/contact" class="cta-button-inverted">
				Get in touch
			</a>
			</div>
		</section>
	</main>
</Layout>

